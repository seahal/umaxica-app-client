{
  "name": "umaxica-apps-cli",
  "dockerComposeFile": ["../compose.yaml", "./compose.override.yml"],
  "service": "core",
  "remoteUser": "client",
  "containerUser": "client",
  "workspaceFolder": "/home/client/workspace",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "remoteEnv": {
    "EDITOR": "code --wait --reuse-window"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "anthropic.claude-code",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github",
        "ms-vscode.remote-explorer",
        "-GitHub.copilot",
        "-GitHub.copilot-chat",
        "-eamodio.gitlens"
      ],
      "settings": {
        "extensions.verifySignature": false,
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.allTargets": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" }
        }
      }
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/codex:1": {}
  },
  "containerEnv": {
    "CARGO_HOME": "/home/client/.cargo"
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/client/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/client/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/client/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/client/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/git,target=/home/client/.config/git,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/client/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/client/.ssh,type=bind,consistency=cached"
  ],
  "updateRemoteUserUID": true
}
